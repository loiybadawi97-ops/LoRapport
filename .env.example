# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# REVENUECAT_WEBHOOK_SECRET: Shared secret used to verify that incoming requests
# to POST /webhooks/revenuecat actually came from RevenueCat.
# Generate any long random string, set it here, and paste the SAME value into
# RevenueCat > Project Settings > Integrations > Webhooks > "Authorization header value".
REVENUECAT_WEBHOOK_SECRET="MY_REVENUECAT_WEBHOOK_SECRET"

# Firebase Admin SDK credentials — required for auth verification and Firestore
# access (see server.ts). Only needed outside Google-hosted environments
# (AI Studio/Cloud Run), which provide these automatically. Use ONE of:
#
#   FIREBASE_SERVICE_ACCOUNT_JSON  — the entire service account JSON file's
#     contents as a single-line env var value. Most portable; works on any
#     host with env vars (Render, Railway, Fly, Vercel, etc). Leave unset
#     locally — use the file option below instead.
#
#   FIREBASE_SERVICE_ACCOUNT_PATH  — path to a service account key file.
#     Defaults to ./firebase-service-account.json if unset, so for local dev
#     just download your key from Firebase console > Project settings >
#     Service accounts > Generate new private key, save it as
#     firebase-service-account.json in the project root, and leave this
#     commented out. That filename is already in .gitignore.
# FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
